<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cadastrar Produto | Painel</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#F9F9FB] text-neutral-900 font-sans antialiased py-10 px-4">

  <div class="max-w-md mx-auto bg-white p-8 rounded-2xl shadow-xl border border-neutral-100">
    
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-bold tracking-tight">Novo Produto</h1>
      <a href="/" class="text-xs font-semibold text-neutral-500 hover:text-black">&larr; Voltar à Vitrine</a>
    </div>

    <!-- Formulário que envia os dados e a foto capturada -->
    <form action="/admin/salvar" method="POST" enctype="multipart/form-data" class="space-y-4">
      
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1">Nome da Peça</label>
        <input type="text" name="nome" required placeholder="Ex: Vestido Midi em Linho" class="w-full px-4 py-3 rounded-lg border border-neutral-200 focus:outline-none focus:ring-2 focus:ring-black text-sm">
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1">Categoria</label>
        <select name="categoria" class="w-full px-4 py-3 rounded-lg border border-neutral-200 focus:outline-none focus:ring-2 focus:ring-black text-sm bg-white">
          <option value="Moda Feminina">Moda Feminina</option>
          <option value="Moda Masculina">Moda Masculina</option>
          <option value="Calçado Feminino">Calçado Feminino</option>
          <option value="Calçado Masculino">Calçado Masculino</option>
          <option value="Tecidos">Tecidos</option>
          <option value="Moda Casa">Moda Casa</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1">Preço (R$)</label>
        <input type="number" step="0.01" name="preco" required placeholder="0.00" class="w-full px-4 py-3 rounded-lg border border-neutral-200 focus:outline-none focus:ring-2 focus:ring-black text-sm">
      </div>

      <!-- Botão da Câmera Nativa -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1">Foto da Câmera / Dispositivo</label>
        
        <!-- O atributo capture="environment" abre a câmera traseira no celular e webcam/arquivo no PC -->
        <input type="file" name="foto" accept="image/*" capture="environment" required id="fileInput" class="w-full text-sm text-neutral-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-black file:text-white hover:file:bg-neutral-800 cursor-pointer border border-neutral-200 rounded-lg p-2 bg-neutral-50">
      </div>

      <button type="submit" class="w-full bg-black text-white py-3.5 rounded-lg font-medium hover:bg-neutral-800 transition shadow-md text-sm mt-4">
        Salvar e Publicar na Vitrine
      </button>

    </form>
  </div>

</body>
</html>